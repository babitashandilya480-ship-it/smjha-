+"""Cheaper Inference adapter. Explicit cloud routing; no fallback or automatic retry."""
+import asyncio
+import json
+import os
+from uuid import uuid4
+from dotenv import load_dotenv
+import httpx
+from . import config, foundation_store as store
+from .foundation_provider import ProviderError, OUTPUT_TOKENS, SECONDS, MAX_INPUT_BYTES
+
+load_dotenv(config.ROOT / 'backend' / '.env.cloud')
+BASE_URL = 'https://api.cheaperinference.com/v1'
+
+def settings():
+    return {'key': os.getenv('CI_API_KEY', ''), 'model': os.getenv('CI_MODEL', 'gpt-5.6-luna'),
+            'enabled': os.getenv('CI_ENABLED', 'false').lower() == 'true',
+            'allowance': max(0, int(os.getenv('CI_MAX_REQUESTS', '0')))}
+
+def status():
+    s = settings()
+    ready = bool(s['key']) and s['enabled'] and s['allowance'] > 0
+    return {'available': ready, 'model': s['model'], 'provider': 'Cheaper Inference',
+            'routing': 'cloud', 'evaluation': 'not_live_verified',
+            'message': 'Sends this conversation to Cheaper Inference and its selected upstream provider.' if ready else
+            'Cloud is disabled. Configure a replacement key, model, provider spending cap and request allowance locally.'}
+
+def headers():
+    key = settings()['key']
+    if not key:
+        raise ProviderError('missing_key', 'Add a replacement CI_API_KEY to backend/.env.cloud.')
+    return {'Authorization': 'Bearer ' + key, 'x-ci-prompt-cache': 'off'}
+
+async def catalog():
+    try:
+        async with httpx.AsyncClient(timeout=15, trust_env=False, follow_redirects=False) as client:
+            r = await client.get(BASE_URL + '/models', headers=headers(), params={'type': 'text', 'streaming': 'true', 'zdr': 'true'})
+            if r.status_code != 200:
+                raise ProviderError('catalog_unavailable', 'Model catalog unavailable. Check the key and account permissions.')
+            return r.json()
+    except (httpx.HTTPError, ValueError):
+        raise ProviderError('catalog_unavailable', 'Could not read the model catalog.')
+
