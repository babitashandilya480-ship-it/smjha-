--- a/backend/samjha/foundation_api.py
+++ b/backend/samjha/foundation_api.py
@@ -0,0 +1,252 @@
+"""Authenticated P1 chat routes; loopback, single-worker deployment only."""
+import asyncio
+import hashlib
+import hmac
+import json
+import secrets
+import time
+from datetime import datetime, timezone
+from typing import Literal
+from uuid import UUID, uuid4
+from fastapi import APIRouter, Depends, HTTPException, Request, Response
+from fastapi.responses import StreamingResponse
+from pydantic import BaseModel, ConfigDict, Field
+from . import foundation_store as store, foundation_provider as local, cloud_provider as cloud
+
+router = APIRouter(prefix='/api/v1')
+tasks = {}
+attempts = {}
+COOKIE = 'samjha_session'
+
+def fail(code, message, status=400):
+    raise HTTPException(status, detail={'code':code, 'message':message, 'retryable':status in (429,503), 'trace_id':str(uuid4())})
+
+class Credentials(BaseModel):
+    model_config = ConfigDict(extra='forbid')
+    username: str = Field(pattern=r'^[a-zA-Z0-9_.-]{3,40}$')
+    password: str = Field(min_length=12,max_length=128)
+
+class NewConversation(BaseModel):
+    model_config = ConfigDict(extra='forbid')
+    route: Literal['local','cloud'] = 'local'
+
+class Message(BaseModel):
+    model_config = ConfigDict(extra='forbid',str_strip_whitespace=True)
+    request_id: UUID
+    content: str = Field(min_length=1,max_length=4000)
+    mode: Literal['chat'] = 'chat'
+    effort: Literal['quick','balanced','thorough'] = 'balanced'
+
+def password_hash(value,salt):
+    return hashlib.scrypt(value.encode(),salt=bytes.fromhex(salt),n=16384,r=8,p=1).hex()
+
+def user(request:Request):
+    token = hashlib.sha256(request.cookies.get(COOKIE,'').encode()).hexdigest()
+    with store.connect() as c:
+        row = c.execute('SELECT u.id,u.username FROM sessions s JOIN users u ON u.id=s.user_id WHERE s.token_hash=? AND s.expires>?',(token,time.time())).fetchone()
+    if not row: fail('authentication','Sign in to access your chats.',401)
+    return dict(row)
+
+def new_session(c,identity,response):
+    token = secrets.token_urlsafe(32)
+    c.execute('DELETE FROM sessions WHERE expires<=?',(time.time(),))
+    c.execute('INSERT INTO sessions VALUES(?,?,?)',(hashlib.sha256(token.encode()).hexdigest(),identity,time.time()+43200))
+    response.set_cookie(COOKIE,token,max_age=43200,httponly=True,samesite='strict',path='/api/v1')
+
+def throttle(request):
+    key = request.client.host if request.client else 'local'
+    recent = [t for t in attempts.get(key,[]) if t>time.monotonic()-60]
+    if len(recent)>=10: fail('rate_limit','Too many sign-in attempts. Wait one minute.',429)
+    attempts[key] = recent+[time.monotonic()]
+
+@router.post('/auth/register')
+def register(value:Credentials,request:Request,response:Response):
+    import sqlite3
+    throttle(request)
+    salt = secrets.token_hex(16)
+    encoded = salt+':'+password_hash(value.password,salt)
+    identity = {'id':str(uuid4()),'username':value.username.lower()}
+    with store.connect() as c:
+        try: c.execute('INSERT INTO users VALUES(?,?,?,?)',(identity['id'],identity['username'],encoded,store.now()))
+        except sqlite3.IntegrityError: fail('username_unavailable','Choose another username.',409)
+        new_session(c,identity['id'],response)
+    return identity
+
+@router.post('/auth/login')
+def login(value:Credentials,request:Request,response:Response):
+    throttle(request)
+    with store.connect() as c:
+        row = c.execute('SELECT * FROM users WHERE username=?',(value.username.lower(),)).fetchone()
+        salt,expected = row['password_hash'].split(':') if row else ('0'*32,'0'*128)
+        valid = hmac.compare_digest(password_hash(value.password,salt),expected)
+        if not row or not valid: fail('authentication','Username or password is incorrect.',401)
+        new_session(c,row['id'],response)
+    return {'id':row['id'],'username':row['username']}
+
+@router.get('/auth/me')
+def me(identity=Depends(user)): return identity
+
+@router.post('/auth/logout')
+def logout(request:Request,response:Response,identity=Depends(user)):
+    with store.connect() as c:
+        c.execute('DELETE FROM sessions WHERE token_hash=?',(hashlib.sha256(request.cookies.get(COOKIE,'').encode()).hexdigest(),))
+    response.delete_cookie(COOKIE,path='/api/v1')
+    return {'signed_out':True}
+
+def owned(c,key,identity):
+    row = c.execute('SELECT * FROM conversations WHERE id=? AND owner_id=?',(str(key),identity['id'])).fetchone()
+    if not row: fail('not_found','Conversation not found.',404)
+    return row
+
+def owned_run(c,key,identity):
+    row = c.execute('SELECT r.* FROM runs r JOIN conversations v ON v.id=r.conversation_id WHERE r.id=? AND v.owner_id=?',(str(key),identity['id'])).fetchone()
+    if not row: fail('not_found','Run not found.',404)
+    return row
+
+@router.get('/capabilities')
+async def capabilities(identity=Depends(user)):
+    return {'local':await local.model_info(),'cloud':cloud.status(),'chat':'beta','hyper':'planned','work':'planned','memory':'off'}
+
+@router.get('/conversations')
+def conversations(identity=Depends(user)):
+    with store.connect() as c:
+        return [dict(r) for r in c.execute('SELECT id,title,route,created_at FROM conversations WHERE owner_id=? ORDER BY created_at DESC LIMIT 100',(identity['id'],))]
+
+@router.post('/conversations')
+def create(value:NewConversation,identity=Depends(user)):
+    if value.route=='cloud' and not cloud.status()['available']: fail('cloud_disabled',cloud.status()['message'],503)
+    result = {'id':str(uuid4()),'title':'New conversation','created_at':store.now(),'route':value.route}
+    with store.connect() as c:
+        c.execute('INSERT INTO conversations VALUES(?,?,?,?,?)',(result['id'],identity['id'],result['title'],result['created_at'],result['route']))
+    return result
+
+@router.get('/conversations/{key}')
+def conversation(key:UUID,identity=Depends(user)):
+    with store.connect() as c:
+        result = dict(owned(c,key,identity))
+        result.pop('owner_id')
+        result['messages'] = [dict(r) for r in c.execute('SELECT * FROM messages WHERE conversation_id=? ORDER BY rowid',(str(key),))]
+        result['runs'] = [dict(r) for r in c.execute('SELECT * FROM runs WHERE conversation_id=? ORDER BY rowid',(str(key),))]
+    return result
+
+async def execute(key,conversation_id,messages,effort,route,gate):
+    text,usage = '',{}
+    try:
+        async with asyncio.timeout(local.SECONDS):
+            stream = cloud.stream if route=='cloud' else local.stream
+            async for item in stream(messages,effort):
+                with store.connect() as c:
+                    state = c.execute('SELECT state FROM runs WHERE id=?',(key,)).fetchone()
+                    if not state or state[0]!='running': return
+                    if 'text' in item:
+                        text += item['text']
+                        if len(text.encode())>24000: raise local.ProviderError('output_limit','Response exceeded its output budget.')
+                        store.event(c,key,'text.delta',{'text':item['text']})
+                    usage = item.get('usage',usage)
+        if not text.strip(): raise local.ProviderError('empty_output','The provider returned no answer.')
+        with store.connect() as c:
+            if c.execute('SELECT state FROM runs WHERE id=?',(key,)).fetchone()[0]=='running':
+                c.execute('INSERT INTO messages VALUES(?,?,?,?,?,?)',(str(uuid4()),conversation_id,key,'assistant',text,store.now()))
+                store.terminal(c,key,'completed',{'usage':usage,'truncated':usage.get('done_reason')=='length'})
+    except asyncio.CancelledError:
+        with store.connect() as c: store.terminal(c,key,'cancelled',{'message':'Stopped. Partial text is retained.'})
+    except (local.ProviderError,TimeoutError) as exc:
+        with store.connect() as c:
+            store.terminal(c,key,'failed',{'code':getattr(exc,'code','budget_exhausted'),'message':getattr(exc,'message','The 60-second run budget was exhausted.'),'retryable':True,'trace_id':key})
+    except Exception:
+        with store.connect() as c:
+            store.terminal(c,key,'failed',{'code':'internal','message':'The run failed. Check service health and retry.','trace_id':key})
+    finally:
+        tasks.pop(key,None)
+
+@router.post('/conversations/{key}/messages')
+async def submit(key:UUID,value:Message,request:Request,identity=Depends(user)):
+    digest = hashlib.sha256(value.model_dump_json().encode()).hexdigest()
+    with store.connect() as c:
+        conv = owned(c,key,identity)
+        old = c.execute('SELECT * FROM runs WHERE conversation_id=? AND request_id=?',(str(key),str(value.request_id))).fetchone()
+        if old:
+            if old['request_hash']!=digest: fail('idempotency_conflict','Request ID already used for different content.',409)
+            return dict(old)
+        history = [dict(r) for r in c.execute("SELECT m.role,m.content FROM messages m JOIN runs r ON r.id=m.run_id WHERE m.conversation_id=? AND r.state='completed' ORDER BY m.rowid",(str(key),))]
+    messages = [{'role':'system','content':local.SYSTEM},*history,{'role':'user','content':value.content}]
+    if len(json.dumps(messages,ensure_ascii=False).encode())>local.MAX_INPUT_BYTES:
+        fail('context_limit','Conversation context is full. Start a new chat; this history is preserved.',422)
+    gate = request.app.state.foundation_gate
+    if gate.locked(): fail('busy','Another model request is running. Wait or stop it first.',429)
+    await gate.acquire()
+    try:
+        info = cloud.status() if conv['route']=='cloud' else await local.model_info()
+        if not info['available']: fail('model_unavailable',info.get('message','Model unavailable.'),503)
+        with store.connect() as c:
+            c.execute('BEGIN IMMEDIATE')
+            owned(c,key,identity)
+            since = datetime.fromtimestamp(time.time()-3600,timezone.utc).isoformat()
+            count = c.execute('SELECT count(*) FROM runs r JOIN conversations v ON v.id=r.conversation_id WHERE v.owner_id=? AND r.created_at>?',(identity['id'],since)).fetchone()[0]
+            if count>=60: fail('quota','Limit of 60 chat requests per hour reached.',429)
+            run_id = str(uuid4())
+            c.execute('INSERT INTO runs VALUES(?,?,?,?,?,?,?,?,?)',(run_id,str(key),str(value.request_id),digest,'running',info['model'],info.get('digest',''),value.effort,store.now()))
+            c.execute('INSERT INTO messages VALUES(?,?,?,?,?,?)',(str(uuid4()),str(key),run_id,'user',value.content,store.now()))
+            c.execute("UPDATE conversations SET title=? WHERE id=? AND title='New conversation'",(value.content[:70],str(key)))
+            store.event(c,run_id,'run.started',{'model':info['model'],'route':conv['route'],'effort':value.effort,'seconds_budget':local.SECONDS,'prompt_version':local.PROMPT_VERSION})
+        tasks[run_id] = asyncio.create_task(execute(run_id,str(key),messages,value.effort,conv['route'],gate))
+        tasks[run_id].add_done_callback(lambda done: gate.release())
+    except BaseException:
+        gate.release()
+        raise
+    return {'id':run_id,'state':'running'}
+
+@router.get('/runs/{key}')
+def get_run(key:UUID,identity=Depends(user)):
+    with store.connect() as c: return dict(owned_run(c,key,identity))
+
+@router.post('/runs/{key}/cancel')
+async def cancel(key:UUID,identity=Depends(user)):
+    with store.connect() as c:
+        owned_run(c,key,identity)
+        store.terminal(c,str(key),'cancelled',{'message':'Stopped. Upstream usage may still be charged.'})
+    if str(key) in tasks: tasks[str(key)].cancel()
+    return {'state':get_run(key,identity)['state']}
+
+@router.get('/runs/{key}/events')
+async def events(key:UUID,request:Request,after:int=0,identity=Depends(user)):
+    try: cursor = max(0,after,int(request.headers.get('last-event-id','0')))
+    except ValueError: fail('cursor','Invalid event cursor.',422)
+    with store.connect() as c: owned_run(c,key,identity)
+    async def generate():
+        nonlocal cursor
+        while True:
+            try:
+                current = user(request)
+                with store.connect() as c:
+                    run = owned_run(c,key,current)
+                    rows = c.execute('SELECT seq,payload FROM events WHERE run_id=? AND seq>? ORDER BY seq LIMIT 100',(str(key),cursor)).fetchall()
+            except HTTPException: return
+            for row in rows:
+                cursor = row['seq']
+                yield f"id: {cursor}\ndata: {row['payload']}\n\n"
+            if run['state']!='running' and len(rows)<100: return
+            if await request.is_disconnected(): return
+            await asyncio.sleep(0.15)
+    return StreamingResponse(generate(),media_type='text/event-stream',headers={'Cache-Control':'no-store','X-Accel-Buffering':'no'})
+
+@router.get('/export')
+def export(identity=Depends(user)):
+    with store.connect() as c:
+        ids = [r['id'] for r in c.execute('SELECT id FROM conversations WHERE owner_id=?',(identity['id'],))]
+    return {'exported_at':store.now(),'user':identity,'conversations':[conversation(UUID(k),identity) for k in ids]}
+
+@router.delete('/account')
+def delete_account(response:Response,identity=Depends(user)):
+    with store.connect() as c:
+        c.execute('BEGIN IMMEDIATE')
+        active = c.execute("SELECT count(*) FROM runs r JOIN conversations v ON v.id=r.conversation_id WHERE v.owner_id=? AND r.state='running'",(identity['id'],)).fetchone()[0]
+        if active: fail('busy','Stop your active response before deleting this account.',409)
+        c.execute('DELETE FROM users WHERE id=?',(identity['id'],))
+    response.delete_cookie(COOKIE,path='/api/v1')
+    return {'deleted':True,'note':'External exports, provider records and operator backups are not erased.'}
+
+async def shutdown():
+    pending = list(tasks.values())
+    for task in pending: task.cancel()
+    if pending: await asyncio.gather(*pending,return_exceptions=True)
