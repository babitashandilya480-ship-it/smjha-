+"""Separate local account database. Never reads the guest learning database."""
+import json
+import os
+import sqlite3
+from contextlib import contextmanager
+from datetime import datetime, timezone
+from pathlib import Path
+from . import config
+
+def path():
+    # Tests that override the old database also receive an isolated chat database.
+    return Path(os.getenv('SAMJHA_CHAT_DB', str(config.DB_PATH.with_name(config.DB_PATH.stem + '-chat.sqlite3'))))
+
+def now():
+    return datetime.now(timezone.utc).isoformat()
+
+@contextmanager
+def connect():
+    target = path()
+    target.parent.mkdir(parents=True, exist_ok=True)
+    c = sqlite3.connect(target, timeout=5)
+    c.row_factory = sqlite3.Row
+    c.execute('PRAGMA foreign_keys=ON')
+    c.execute('PRAGMA secure_delete=ON')
+    try:
+        with c:
+            yield c
+    finally:
+        c.close()
+
+def event(c, run_id, kind, data):
+    seq = c.execute('SELECT coalesce(max(seq),0)+1 FROM events WHERE run_id=?', (run_id,)).fetchone()[0]
+    payload = {'schema_version': 1, 'run_id': run_id, 'seq': seq, 'type': kind, 'timestamp': now(), 'data': data}
+    c.execute('INSERT INTO events VALUES(?,?,?)', (run_id, seq, json.dumps(payload, ensure_ascii=False)))
+
+def terminal(c, run_id, state, data):
+    if c.execute("UPDATE runs SET state=? WHERE id=? AND state='running'", (state, run_id)).rowcount:
+        event(c, run_id, 'run.' + state, data)
+
+def init():
+    with connect() as c:
+        c.executescript(Path(__file__).with_name('foundation_schema.sql').read_text(encoding='utf-8'))
+        for row in c.execute("SELECT id FROM runs WHERE state='running'").fetchall():
+            terminal(c, row['id'], 'failed', {'code': 'interrupted', 'message':
+                'The server restarted. Partial output is retained; retry starts a new run.', 'retryable': True})
