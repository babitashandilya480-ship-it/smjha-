+        raise ProviderError('timeout', 'Cloud request exceeded its time budget. It was not retried.')
+    except httpx.HTTPError:
+        raise ProviderError('connection_failure', 'Cloud connection failed. It was not retried.')
+    except (ValueError, TypeError, AttributeError, KeyError):
+        raise ProviderError('invalid_output', 'Cloud provider returned an unreadable response.')
+    finally:
+        with store.connect() as c:
+            c.execute('UPDATE cloud_calls SET usage=? WHERE id=?', (json.dumps(usage), call_id))
