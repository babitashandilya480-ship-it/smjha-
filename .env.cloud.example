# Copy to backend/.env.cloud. Never use a VITE_ prefix for secrets.
# Revoke the previously shared key; enter a new key only in the local file.
CI_API_KEY=
CI_MODEL=gpt-5.6-luna
CI_ENABLED=false
# Lifetime request allowance shared by app + development helper. Zero blocks paid calls.
# Raise only after setting a provider-side key spending cap and reviewing model prices.
CI_MAX_REQUESTS=0
# Cloud ZDR is always requested. No local-to-cloud fallback is implemented.
TAVILY_API_KEY=
